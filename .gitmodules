[submodule "parquet-testing"]
	path = parquet-testing
	url = https://github.com/apache/parquet-testing.git
[submodule "testing"]
	path = testing
	url = https://github.com/apache/arrow-testing
# Dependents such as DEN fetch this repo as a Cargo git dependency, and Cargo skips submodules marked update = none; the SQLite extended tests check it out explicitly.
[submodule "datafusion-testing"]
	path = datafusion-testing
	url = https://github.com/apache/datafusion-testing.git
	branch = main
	update = none
